// FlagLab — modelo de dados (IC-DB-02)
// Migrações em db/migrations/ (IC-DB-01)

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Ambiente {
  DEV
  HOMOLOG
  PROD
}

/// O item de configuração: uma funcionalidade que pode ser ligada ou desligada.
model Flag {
  id        Int          @id @default(autoincrement())
  chave     String       @unique @db.VarChar(60)
  descricao String       @db.VarChar(200)
  criadoEm  DateTime     @default(now()) @map("criado_em")
  versoes   FlagVersao[]

  @@map("flags")
}

/// Quem pode alterar flags. O token só é mostrado na criação; no banco fica apenas o hash SHA-256.
model Usuario {
  id        Int          @id @default(autoincrement())
  nome      String       @db.VarChar(80)
  email     String       @unique @db.VarChar(160)
  tokenHash String       @unique @map("token_hash") @db.Char(64)
  criadoEm  DateTime     @default(now()) @map("criado_em")
  versoes   FlagVersao[]

  @@map("usuarios")
}

/// Cada mudança gera uma versão NOVA (o histórico nunca é editado). O estado atual é a maior versão do ambiente.
/// `autor` guarda o nome no momento da mudança (fotografia para auditoria); `autorId` liga ao usuário.
model FlagVersao {
  id         Int      @id @default(autoincrement())
  flagId     Int      @map("flag_id")
  ambiente   Ambiente
  versao     Int
  ativa      Boolean
  percentual Int      @default(100)
  autor      String   @db.VarChar(80)
  autorId    Int?     @map("autor_id")
  motivo     String   @db.VarChar(300)
  criadoEm   DateTime @default(now()) @map("criado_em")
  flag       Flag     @relation(fields: [flagId], references: [id])
  usuario    Usuario? @relation(fields: [autorId], references: [id])

  @@unique([flagId, ambiente, versao])
  @@map("flag_versoes")
}
